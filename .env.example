# Copy to .env for local dev with `vercel dev` (never commit .env — it's gitignored).
# In production set these in: Vercel → Project → Settings → Environment Variables.
#
# Every key here is read ONLY inside api/*.js, which runs server-side on Vercel.
# None of them is bundled into the PWA, and none is reachable from the browser.
#
# All three are OPTIONAL. Each endpoint returns HTTP 503 when its key is absent
# and the app falls back to its offline path, so the build never breaks over a
# missing key — the corresponding feature simply stays dormant.

# ---------------------------------------------------------------------------
# THE ONE KEY THAT MATTERS.  Set this and everything AI works.
#
# Drives three things:
#   api/localize-vision.js  camera localization — "Point Camera" and the
#                           automatic re-centring toggle
#   api/intent.js           chat natural-language understanding
#   api/product-match.js    price-scanner product verification
#
# Without it: the camera features are inert (the frame is discarded and the
# user gets the manual picker) and the chat falls back to offline keyword
# matching. Nothing breaks; those features simply stay dormant.
#
# Get a key at https://platform.openai.com/api-keys — and add credit at
# platform.openai.com/settings/billing, or every call returns 401.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-paste-your-key-here

# Optional — model overrides. Defaults are the cheapest that do the job.
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TEXT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# ALTERNATIVE to OpenAI for the two TEXT/CHAT endpoints (api/intent.js and
# api/product-match.js). Not needed if OPENAI_API_KEY is set — that one is
# preferred automatically.
#
# Worth adding only if chat volume grows enough that Gemini's free tier beats
# paying per message. Camera localization always uses OpenAI regardless.
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=AIza-paste-your-key-here
# GEMINI_MODEL=gemini-2.0-flash

# Force a provider instead of auto-selecting: 'openai' or 'gemini'.
# Deliberately fails closed — forcing a provider whose key is absent returns
# 503 rather than silently using the other one and hiding the misconfiguration.
# LLM_PROVIDER=openai

# ---------------------------------------------------------------------------
# Indian-language speech.  api/voice-stt.js (Saarika), api/voice-tts.js (Bulbul)
# Without it: the browser's built-in Web Speech API is used instead, which
# works in Chrome and Safari but handles Indian accents and Kannada poorly.
# Get a key at https://dashboard.sarvam.ai
# ---------------------------------------------------------------------------
SARVAM_API_KEY=paste-your-key-here
