# Copy to .env for local dev with `vercel dev` (never commit .env — it's gitignored).
# In production set this in: Vercel → Project → Settings → Environment Variables.
# The key lives ONLY server-side in api/intent.js and api/product-match.js —
# it is never bundled into the PWA. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-paste-your-key-here

# Optional — override the model without a code change (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash
